<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contáctanos</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(to right, #1e3c72, #2a5298); /* Azul profesional */
            margin: 0;
            padding: 0;
            color: #333;
        }
    
        /* Barra de navegación */
        .navbar {
            background-color: rgba(0, 0, 0, 0.85);
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
    
        .navbar a {
            color: #f0e68c;
            text-decoration: none;
            font-size: 1.1em;
            font-weight: 600;
            transition: color 0.3s ease;
        }
    
        .navbar a:hover {
            color: #fffacd;
        }
    
        .container {
            max-width: 600px;
            margin: 60px auto;
            padding: 30px;
            background-color: #ffffff;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
            border-radius: 10px;
        }
    
        h1 {
            text-align: center;
            color: #1e3c72;
            margin-bottom: 25px;
            font-size: 26px;
        }
    
        form {
            display: flex;
            flex-direction: column;
        }
    
        label {
            margin-bottom: 6px;
            color: #555;
            font-weight: bold;
        }
    
        input[type="email"],
        input[type="tel"],
        textarea {
            padding: 12px;
            margin-bottom: 20px;
            border: 1px solid #bbb;
            border-radius: 6px;
            font-size: 16px;
            transition: border-color 0.3s;
        }
    
        input[type="email"]:focus,
        input[type="tel"]:focus,
        textarea:focus {
            border-color: #1e3c72;
            outline: none;
        }
    
        input[type="submit"] {
            padding: 12px;
            background-color: #f0e68c;
            color: #1e3c72;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 16px;
            font-weight: bold;
            transition: background-color 0.3s, color 0.3s;
        }
    
        input[type="submit"]:hover {
            background-color: #fffacd;
            color: #000;
        }
    </style>
    
</head>
<body>

    <!-- Barra de navegación -->
    <div class="navbar">
        <a href="menu_principal">Volver al Inicio</a>
    </div>

    <div class="container">
        <h1>Contáctanos</h1>
        <form action="#" method="post">
            <label for="email">Correo Electrónico:</label>
            <input type="email" id="email" name="email" required>

            <label for="tel">Teléfono:</label>
            <input type="tel" id="tel" name="tel" required>

            <input type="submit" value="Enviar">
        </form>
    </div>
</body>
</html>
